# --- Database ---
DATABASE_URL=sqlite:///./smart_certificate.db

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- SMTP / Email (leave blank to run without email; certificates will
# still generate and be marked "Email Pending") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Organization / Certificate branding ---
ORGANIZATION_NAME=Acme Learning & Development
CERTIFICATE_SIGNATURE_NAME=Shrithii

# --- Automation / Scheduler ---
AUTOMATION_INTERVAL_MINUTES=30
ENABLE_AUTOMATION=true

# --- Misc ---
FRONTEND_URL=http://localhost:5173
DEFAULT_TARGET_HOURS=50
